<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.scbk.cert</groupId>
    <artifactId>mobile-cert</artifactId>
    <version>1.0</version>
    <packaging>jar</packaging>
    <name>mobile-cert</name>
    <properties>
        <project.build.sourceEncoding>EUC-KR</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <build.java.required>[21,22)</build.java.required>
        <build.java8.selected>false</build.java8.selected>
        <build.java21.selected>false</build.java21.selected>
        <build.java.selection>${build.java8.selected}/${build.java21.selected}</build.java.selection>
        <log4j.version>2.17.1</log4j.version>
        <hikari.version>7.0.2</hikari.version>
        <ojdbc.version>23.26.3.0.0</ojdbc.version>
        <ojdbc.artifactId>ojdbc11</ojdbc.artifactId>
        <slf4j.version>2.0.17</slf4j.version>
        <jacoco.version>0.8.14</jacoco.version>
        <argLine></argLine>
        <test.excludedGroups>readiness | inactive-lgu | oracle</test.excludedGroups>
    </properties>
    <dependencies>
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>${hikari.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-jdk14</artifactId>
            <version>${slf4j.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>${log4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>${log4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-1.2-api</artifactId>
            <version>${log4j.version}</version>
        </dependency>
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>${ojdbc.artifactId}</artifactId>
            <version>${ojdbc.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.13.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions><execution>
                    <id>matching-build-jdk</id>
                    <goals><goal>enforce</goal></goals>
                    <configuration><rules>
                        <requireJavaVersion>
                            <version>${build.java.required}</version>
                            <message>Use JDK 8 with -Pjava8, or JDK 21 with -Pjava21. Check mvn -version.</message>
                        </requireJavaVersion>
                        <requireProperty>
                            <property>build.java.selection</property>
                            <regex>false/false|true/false|false/true</regex>
                            <regexMessage>Select only one runtime profile: java8 or java21.</regexMessage>
                        </requireProperty>
                    </rules></configuration>
                </execution></executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <encoding>${project.build.sourceEncoding}</encoding>
                    <failOnError>true</failOnError>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
                <configuration>
                    <!-- Both runtimes test legacy protocol bytes with a UTF-8 default. -->
                    <argLine>@{argLine} -Dfile.encoding=UTF-8</argLine>
                    <excludedGroups>${test.excludedGroups}</excludedGroups>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>runtime-libraries</id>
                        <phase>package</phase>
                        <goals><goal>copy-dependencies</goal></goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!-- Use the matching JDK. clean removes libraries from the other profile. -->
        <profile>
            <id>java8</id>
            <activation><jdk>[1.8,1.9)</jdk></activation>
            <properties>
                <build.java8.selected>true</build.java8.selected>
                <build.java.required>[1.8,1.9)</build.java.required>
                <maven.compiler.release>8</maven.compiler.release>
                <hikari.version>4.0.3</hikari.version>
                <ojdbc.artifactId>ojdbc8</ojdbc.artifactId>
            </properties>
        </profile>
        <profile>
            <id>java21</id>
            <properties>
                <build.java21.selected>true</build.java21.selected>
                <build.java.required>[21,22)</build.java.required>
                <maven.compiler.release>21</maven.compiler.release>
                <hikari.version>7.0.2</hikari.version>
                <ojdbc.artifactId>ojdbc11</ojdbc.artifactId>
            </properties>
        </profile>
        <profile>
            <id>oracle</id>
            <properties><test.excludedGroups>readiness</test.excludedGroups></properties>
            <build><plugins><plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <groups>oracle</groups>
                    <forkedProcessTimeoutInSeconds>120</forkedProcessTimeoutInSeconds>
                </configuration>
            </plugin></plugins></build>
        </profile>
        <profile>
            <id>oracle-readiness</id>
            <properties><test.excludedGroups>none</test.excludedGroups></properties>
            <build><plugins><plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <groups>oracle &amp; readiness</groups>
                    <forkedProcessTimeoutInSeconds>120</forkedProcessTimeoutInSeconds>
                </configuration>
            </plugin></plugins></build>
        </profile>
        <!-- Desired failure handling. Known defects deliberately fail this gate. -->
        <profile>
            <id>readiness</id>
            <properties><test.excludedGroups>inactive-lgu | oracle</test.excludedGroups></properties>
            <build><plugins><plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration><groups>readiness</groups></configuration>
            </plugin></plugins></build>
        </profile>
        <!-- Historical LG U+ diagnostics: this provider is not currently used. -->
        <profile>
            <id>legacy-lgu</id>
            <properties><test.excludedGroups>none</test.excludedGroups></properties>
            <build><plugins><plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration><groups>inactive-lgu</groups></configuration>
            </plugin></plugins></build>
        </profile>
        <profile>
            <id>coverage</id>
            <build><plugins><plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution><goals><goal>prepare-agent</goal></goals></execution>
                    <execution><id>coverage-report</id><phase>verify</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                </executions>
            </plugin></plugins></build>
        </profile>
    </profiles>
</project>
