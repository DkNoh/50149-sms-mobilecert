<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="OFF">
  <Appenders>
    <Console name="Console" target="SYSTEM_OUT">
      <PatternLayout charset="UTF-8" pattern="%d{HH:mm:ss} %-5level %msg%n"/>
    </Console>
  </Appenders>
  <Loggers>
    <Logger name="log.day" level="debug" additivity="false"><AppenderRef ref="Console"/></Logger>
    <Logger name="log.root" level="debug" additivity="false"><AppenderRef ref="Console"/></Logger>
    <Root level="off"/>
  </Loggers>
</Configuration>
